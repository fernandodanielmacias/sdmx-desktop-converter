<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.ordonovus</groupId>
    <artifactId>sdmx-desktop-converter</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <name>SDMX Desktop Converter</name>
    <description>
        JavaFX desktop application for converting Excel files to SDMX-XML.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <javafx.version>21.0.12</javafx.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.13.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <executable>${java.home}/bin/java</executable>

                    <mainClass>
                        io.github.ordonovus.sdmxconverter/io.github.ordonovus.sdmxconverter.SdmxDesktopApplication
                    </mainClass>

                    <stripDebug>true</stripDebug>
                    <noHeaderFiles>true</noHeaderFiles>
                    <noManPages>true</noManPages>

                    <launcher>ConvertidorSDMX</launcher>
                    <jlinkImageName>sdmx-converter-runtime</jlinkImageName>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>prepare-jpackage-modules</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>
                                ${project.build.directory}/jpackage-modules
                            </outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>prepare-packaged-converter</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>
                                ${project.build.directory}/jpackage-content/converter/11.8.1/ConverterCLIApp
                            </outputDirectory>

                            <resources>
                                <resource>
                                    <directory>
                                        ${project.basedir}/local/converter/11.8.1/app/ConverterCLIApp
                                    </directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>

                    <execution>
                        <id>prepare-packaged-converter-runtime</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>
                                ${project.build.directory}/jpackage-content/converter-runtime/java-11
                            </outputDirectory>

                            <resources>
                                <resource>
                                    <directory>
                                        ${project.basedir}/local/runtime/converter-java-11
                                    </directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>1.8.0</version>
                <configuration>
                    <name>Convertidor SDMX</name>
                    <appVersion>1.0.0</appVersion>
                    <vendor>Ordo Novus</vendor>

                    <description>Aplicación de escritorio para convertir archivos Excel a SDMX-XML.</description>

                    <type>APP_IMAGE</type>

                    <modulePaths>
                        <modulePath>
                            ${project.build.directory}/${project.build.finalName}.jar
                        </modulePath>

                        <modulePath>
                            ${project.build.directory}/jpackage-modules
                        </modulePath>
                    </modulePaths>

                    <appContentPaths>
                        <path>
                            ${project.build.directory}/jpackage-content/converter
                        </path>

                        <path>
                            ${project.build.directory}/jpackage-content/converter-runtime
                        </path>
                    </appContentPaths>

                    <module>
                        io.github.ordonovus.sdmxconverter/io.github.ordonovus.sdmxconverter.SdmxDesktopApplication
                    </module>

                    <destination>
                        ${project.build.directory}/distribution
                    </destination>

                    <javaOptions>
                        <option>-Dfile.encoding=UTF-8</option>
                    </javaOptions>

                    <removeDestination>true</removeDestination>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <useModulePath>true</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>