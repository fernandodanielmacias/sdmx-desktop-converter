<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.ordonovus.sdmxconverter.presentation.controller.MainController"
            styleClass="application-root">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="header">

            <padding>
                <Insets top="12"
                        right="32"
                        bottom="12"
                        left="32"/>
            </padding>

            <VBox spacing="4">
                <Label text="Convertidor SDMX"
                       styleClass="application-title"/>

                <Label text="Conversión de archivos Excel a SDMX-XML"
                       styleClass="application-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button accessibleText="Configuración"
                    onAction="#onOpenSettings"
                    styleClass="header-settings-button">
                <graphic>
                    <SVGPath content="M19.43,12.98 C19.47,12.66 19.5,12.34 19.5,12 C19.5,11.66 19.47,11.34 19.42,11.02 L21.54,9.37 L19.54,5.91 L17.05,6.91 C16.53,6.5 15.96,6.17 15.34,5.91 L14.96,3.27 L10.96,3.27 L10.58,5.91 C9.96,6.17 9.39,6.51 8.87,6.91 L6.38,5.91 L4.38,9.37 L6.5,11.02 C6.45,11.34 6.42,11.67 6.42,12 C6.42,12.33 6.45,12.66 6.5,12.98 L4.38,14.63 L6.38,18.09 L8.87,17.09 C9.39,17.5 9.96,17.83 10.58,18.09 L10.96,20.73 L14.96,20.73 L15.34,18.09 C15.96,17.83 16.53,17.49 17.05,17.09 L19.54,18.09 L21.54,14.63 Z M12.96,15.5 C11.03,15.5 9.46,13.93 9.46,12 C9.46,10.07 11.03,8.5 12.96,8.5 C14.89,8.5 16.46,10.07 16.46,12 C16.46,13.93 14.89,15.5 12.96,15.5 Z"
                             styleClass="header-settings-icon"/>
                </graphic>

                <tooltip>
                    <Tooltip text="Configuración"/>
                </tooltip>
            </Button>
        </HBox>
    </top>

    <center>
        <ScrollPane fx:id="contentScrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="content-scroll-pane">

            <VBox fx:id="conversionContent"
                    spacing="20">
                <padding>
                    <Insets top="28"
                            right="32"
                            bottom="28"
                            left="32"/>
                </padding>

                <VBox spacing="14"
                      styleClass="card">

                    <HBox alignment="CENTER_LEFT"
                          spacing="12">
                        <VBox spacing="4">
                            <Label text="Archivos de entrada"
                                   styleClass="section-title"/>

                            <Label fx:id="selectionCountLabel"
                                   text="0 archivos seleccionados"
                                   styleClass="secondary-text"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button fx:id="removeSelectedFilesButton"
                                text="Eliminar seleccionados"
                                onAction="#onRemoveSelectedFiles"
                                styleClass="danger-button"/>

                        <Button fx:id="clearFilesButton"
                                text="Limpiar"
                                onAction="#onClearFiles"
                                styleClass="danger-button"/>

                        <Button fx:id="chooseFilesButton"
                                text="Seleccionar Excel"
                                onAction="#onChooseFiles"
                                styleClass="secondary-button"/>
                    </HBox>

                    <TableView fx:id="filesTable"
                               prefHeight="330"
                               minHeight="220">

                        <placeholder>
                            <Label text="No se han seleccionado archivos Excel."
                                   styleClass="table-placeholder"/>
                        </placeholder>

                        <columns>
                            <TableColumn fx:id="fileNameColumn"
                                         text="Archivo de entrada"
                                         prefWidth="220"
                                         minWidth="160"/>

                            <TableColumn fx:id="outputFileNameColumn"
                                         text="Nombre del XML"
                                         prefWidth="220"
                                         minWidth="160"/>

                            <TableColumn fx:id="filePathColumn"
                                         text="Ubicación"
                                         prefWidth="475"
                                         minWidth="260"/>

                            <TableColumn fx:id="statusColumn"
                                         text="Estado"
                                         prefWidth="135"
                                         minWidth="110"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox spacing="12"
                      styleClass="card">
                    <Label text="Carpeta de salida"
                           styleClass="section-title"/>

                    <HBox alignment="CENTER_LEFT"
                          spacing="12">
                        <TextField fx:id="outputDirectoryField"
                                   promptText="Selecciona dónde guardar los archivos XML"
                                   editable="false"
                                   HBox.hgrow="ALWAYS"/>

                        <Button fx:id="chooseOutputDirectoryButton"
                                text="Seleccionar carpeta"
                                onAction="#onChooseOutputDirectory"
                                styleClass="secondary-button"/>
                    </HBox>
                </VBox>

                <VBox spacing="14"
                      styleClass="card">
                    <VBox spacing="4">
                        <Label text="Configuración SDMX"
                               styleClass="section-title"/>

                        <Label text="Selecciona la estructura DSD y el archivo de encabezado."
                               styleClass="secondary-text"/>
                    </VBox>

                    <HBox alignment="CENTER_LEFT"
                          spacing="12">
                        <Label text="Archivo DSD"
                               minWidth="145"
                               styleClass="configuration-key"/>

                        <TextField fx:id="dsdFileField"
                                   promptText="Selecciona el archivo XML de la estructura DSD"
                                   editable="false"
                                   HBox.hgrow="ALWAYS"/>

                        <Button fx:id="chooseDsdFileButton"
                                text="Seleccionar DSD"
                                onAction="#onChooseDsdFile"
                                styleClass="secondary-button"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT"
                          spacing="24"
                          styleClass="configuration-metadata">
                        <Region minWidth="145"/>

                        <HBox alignment="CENTER_LEFT"
                              spacing="6">
                            <Label text="Agencia:"
                                   styleClass="configuration-key"/>

                            <Label fx:id="dsdAgencyValueLabel"
                                   text="Sin configurar"
                                   styleClass="configuration-value"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT"
                              spacing="6">
                            <Label text="ID:"
                                   styleClass="configuration-key"/>

                            <Label fx:id="dsdIdValueLabel"
                                   text="Sin configurar"
                                   styleClass="configuration-value"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT"
                              spacing="6">
                            <Label text="Versión:"
                                   styleClass="configuration-key"/>

                            <Label fx:id="dsdVersionValueLabel"
                                   text="Sin configurar"
                                   styleClass="configuration-value"/>
                        </HBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT"
                          spacing="12">
                        <Label text="Archivo de encabezado"
                               minWidth="145"
                               styleClass="configuration-key"/>

                        <TextField fx:id="headerFileField"
                                   promptText="Selecciona el archivo header.prop"
                                   editable="false"
                                   HBox.hgrow="ALWAYS"/>

                        <Button fx:id="chooseHeaderFileButton"
                                text="Seleccionar encabezado"
                                onAction="#onChooseHeaderFile"
                                styleClass="secondary-button"/>
                    </HBox>
                </VBox>

                <HBox alignment="CENTER_LEFT"
                      spacing="16">

                    <VBox spacing="7"
                          HBox.hgrow="ALWAYS">

                        <Label fx:id="configurationSummaryLabel"
                               text="Convertidor 11.8.1 · DSD sin configurar"
                               styleClass="secondary-text"/>

                        <HBox fx:id="conversionProgressContainer"
                              alignment="CENTER_LEFT"
                              spacing="10"
                              visible="false"
                              managed="false">

                            <ProgressBar fx:id="conversionProgressBar"
                                         progress="0"
                                         prefWidth="280"
                                         maxWidth="360"
                                         HBox.hgrow="ALWAYS"/>

                            <Label fx:id="conversionProgressLabel"
                                   text="Preparando conversiones..."
                                   minWidth="220"
                                   styleClass="conversion-progress-text"/>
                        </HBox>
                    </VBox>

                    <Button fx:id="resetFormButton"
                            text="Restablecer formulario"
                            onAction="#onResetForm"
                            styleClass="warning-button"/>

                    <Button fx:id="cancelConversionButton"
                            text="Cancelar"
                            onAction="#onCancelConversion"
                            visible="false"
                            managed="false"
                            styleClass="danger-button"/>

                    <Button fx:id="convertButton"
                            text="Convertir a SDMX-XML"
                            onAction="#onConvert"
                            defaultButton="true"
                            styleClass="convert-button"/>
                </HBox>

                <VBox fx:id="activityLogPanel"
                      visible="false"
                      spacing="10"
                      styleClass="activity-log-panel">

                    <padding>
                        <Insets top="14"
                                right="16"
                                bottom="14"
                                left="16"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT"
                          spacing="10">
                        <Label text="Registro de actividad"
                               styleClass="activity-log-title"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="Limpiar"
                                onAction="#onClearActivityLog"
                                styleClass="danger-button"/>

                        <Button text="Copiar"
                                onAction="#onCopyActivityLog"
                                styleClass="secondary-button"/>
                    </HBox>

                    <ListView fx:id="activityLogList"
                              prefHeight="165"
                              minHeight="120"
                              maxHeight="200"
                              focusTraversable="false"
                              styleClass="activity-log-list"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT"
              spacing="12"
              styleClass="status-bar">
            <padding>
                <Insets top="10"
                        right="32"
                        bottom="10"
                        left="32"/>
            </padding>

            <Label fx:id="generalStatusLabel"
                   text="Listo para seleccionar archivos."
                   styleClass="status-text"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="toggleActivityLogButton"
                    text="Mostrar actividad"
                    onAction="#onToggleActivityLog"
                    styleClass="activity-toggle-button"/>
        </HBox>
    </bottom>

</BorderPane>