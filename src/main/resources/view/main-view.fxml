<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.ordonovus.sdmxconverter.presentation.controller.MainController"
            styleClass="application-root">

    <top>
        <VBox spacing="6" styleClass="header">
            <padding>
                <Insets top="24" right="32" bottom="24" left="32"/>
            </padding>

            <Label text="SDMX Desktop Converter"
                   styleClass="application-title"/>

            <Label text="Conversión de archivos Excel a SDMX-XML"
                   styleClass="application-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="28" right="32" bottom="28" left="32"/>
            </padding>

            <VBox spacing="16" styleClass="card">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4">
                        <Label text="Archivos de entrada"
                               styleClass="section-title"/>

                        <Label fx:id="selectionCountLabel"
                               text="0 archivos seleccionados"
                               styleClass="secondary-text"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="Eliminar seleccionados"
                            onAction="#onRemoveSelectedFiles"
                            styleClass="secondary-button"/>

                    <Button text="Limpiar"
                            onAction="#onClearFiles"
                            styleClass="secondary-button"/>

                    <Button text="Seleccionar Excel"
                            onAction="#onChooseFiles"
                            styleClass="primary-button"/>
                </HBox>

                <TableView fx:id="filesTable"
                           VBox.vgrow="ALWAYS"
                           prefHeight="360"
                           placeholder="No se han seleccionado archivos Excel.">
                    <columns>
                        <TableColumn fx:id="fileNameColumn"
                                     text="Archivo"
                                     prefWidth="250"/>

                        <TableColumn fx:id="filePathColumn"
                                     text="Ubicación"
                                     prefWidth="570"/>

                        <TableColumn fx:id="statusColumn"
                                     text="Estado"
                                     prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="12" styleClass="card">
                <Label text="Carpeta de salida"
                       styleClass="section-title"/>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <TextField fx:id="outputDirectoryField"
                               promptText="Selecciona dónde guardar los archivos XML"
                               editable="false"
                               HBox.hgrow="ALWAYS"/>

                    <Button text="Seleccionar carpeta"
                            onAction="#onChooseOutputDirectory"
                            styleClass="secondary-button"/>
                </HBox>
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="16">
                <Label text="Converter 11.8.1 · DSD sin configurar"
                       styleClass="secondary-text"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="convertButton"
                        text="Convertir a SDMX-XML"
                        onAction="#onConvert"
                        defaultButton="true"
                        styleClass="convert-button"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="status-bar">
            <padding>
                <Insets top="12" right="32" bottom="12" left="32"/>
            </padding>

            <Label fx:id="generalStatusLabel"
                   text="Listo para seleccionar archivos."
                   styleClass="status-text"/>
        </HBox>
    </bottom>

</BorderPane>
