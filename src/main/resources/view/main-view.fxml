<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.ordonovus.sdmxconverter.presentation.controller.MainController"
            styleClass="application-root">

    <top>
        <VBox spacing="6"
              styleClass="header">
            <padding>
                <Insets top="18"
                        right="32"
                        bottom="18"
                        left="32"/>
            </padding>

            <Label text="Convertidor SDMX"
                   styleClass="application-title"/>

            <Label text="Conversión de archivos Excel a SDMX-XML"
                   styleClass="application-subtitle"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fx:id="contentScrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="content-scroll-pane">

            <VBox spacing="20">
                <padding>
                    <Insets top="28"
                            right="32"
                            bottom="28"
                            left="32"/>
                </padding>

                <VBox spacing="14"
                      styleClass="card">

                    <HBox alignment="CENTER_LEFT"
                          spacing="12">
                        <VBox spacing="4">
                            <Label text="Archivos de entrada"
                                   styleClass="section-title"/>

                            <Label fx:id="selectionCountLabel"
                                   text="0 archivos seleccionados"
                                   styleClass="secondary-text"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="Eliminar seleccionados"
                                onAction="#onRemoveSelectedFiles"
                                styleClass="secondary-button"/>

                        <Button text="Limpiar"
                                onAction="#onClearFiles"
                                styleClass="secondary-button"/>

                        <Button text="Seleccionar Excel"
                                onAction="#onChooseFiles"
                                styleClass="primary-button"/>
                    </HBox>

                    <TableView fx:id="filesTable"
                               prefHeight="355"
                               minHeight="220">

                        <placeholder>
                            <Label text="No se han seleccionado archivos Excel."
                                   styleClass="table-placeholder"/>
                        </placeholder>

                        <columns>
                            <TableColumn fx:id="fileNameColumn"
                                         text="Archivo de entrada"
                                         prefWidth="220"
                                         minWidth="160"/>

                            <TableColumn fx:id="outputFileNameColumn"
                                         text="Nombre del XML"
                                         prefWidth="220"
                                         minWidth="160"/>

                            <TableColumn fx:id="filePathColumn"
                                         text="Ubicación"
                                         prefWidth="475"
                                         minWidth="260"/>

                            <TableColumn fx:id="statusColumn"
                                         text="Estado"
                                         prefWidth="135"
                                         minWidth="110"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox spacing="12"
                      styleClass="card">
                    <Label text="Carpeta de salida"
                           styleClass="section-title"/>

                    <HBox alignment="CENTER_LEFT"
                          spacing="12">
                        <TextField fx:id="outputDirectoryField"
                                   promptText="Selecciona dónde guardar los archivos XML"
                                   editable="false"
                                   HBox.hgrow="ALWAYS"/>

                        <Button text="Seleccionar carpeta"
                                onAction="#onChooseOutputDirectory"
                                styleClass="secondary-button"/>
                    </HBox>
                </VBox>

                <HBox alignment="CENTER_LEFT"
                      spacing="12">
                    <Label text="Convertidor 11.8.1 · DSD sin configurar"
                           styleClass="secondary-text"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="Restablecer formulario"
                            onAction="#onResetForm"
                            styleClass="secondary-button"/>

                    <Button fx:id="convertButton"
                            text="Convertir a SDMX-XML"
                            onAction="#onConvert"
                            defaultButton="true"
                            styleClass="convert-button"/>
                </HBox>

                <VBox fx:id="activityLogPanel"
                      visible="false"
                      spacing="10"
                      styleClass="activity-log-panel">

                    <padding>
                        <Insets top="14"
                                right="16"
                                bottom="14"
                                left="16"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT"
                          spacing="10">
                        <Label text="Registro de actividad"
                               styleClass="activity-log-title"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="Limpiar"
                                onAction="#onClearActivityLog"
                                styleClass="secondary-button"/>

                        <Button text="Copiar"
                                onAction="#onCopyActivityLog"
                                styleClass="secondary-button"/>
                    </HBox>

                    <ListView fx:id="activityLogList"
                              prefHeight="165"
                              minHeight="120"
                              maxHeight="200"
                              focusTraversable="false"
                              styleClass="activity-log-list"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT"
              spacing="12"
              styleClass="status-bar">
            <padding>
                <Insets top="10"
                        right="32"
                        bottom="10"
                        left="32"/>
            </padding>

            <Label fx:id="generalStatusLabel"
                   text="Listo para seleccionar archivos."
                   styleClass="status-text"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="toggleActivityLogButton"
                    text="Mostrar actividad"
                    onAction="#onToggleActivityLog"
                    styleClass="activity-toggle-button"/>
        </HBox>
    </bottom>

</BorderPane>